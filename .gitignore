# macOS
.DS_Store
*.swp

# Editors and local tooling
.vscode/
.idea/
xcuserdata/
*.xcuserstate
.claude/settings.local.json

# Python
__pycache__/
*.py[cod]
.venv/

# Swift app build output
build/

# Simulation save files
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# Unreal: generated by the editor or Build.sh, rebuilt on demand
unreal/Binaries/
unreal/Build/
unreal/Intermediate/
unreal/Saved/
unreal/DerivedDataCache/
unreal/.vs/
unreal/*.xcworkspace/
unreal/*.xcodeproj/
unreal/*.sln
unreal/*.code-workspace
# Per-user editor folder; collaborators get their own
unreal/Content/Developers/
unreal/Content/Collections/

# Stray Xcode workspace left at the repo root by project creation
/FortyDaysUnder/

# Blender: save backups and FBX exports are regenerated from the .blend
*.blend1
blender/export/
